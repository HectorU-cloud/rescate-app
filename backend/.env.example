DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5433/rescate_db
# Obligatoria, minimo 32 caracteres. Generar con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=TU_SECRET_KEY

# Opcional: contrasena de las cuentas demo que crea seed.py
# (si no se define, seed.py genera una y la imprime)
SEED_DEMO_PASSWORD=

# Datos que aparecen en /privacy, /terms y /account-deletion (obligatorio para publicar)
COMPANY_NAME=
SUPPORT_EMAIL=

# Correo para recuperar contrasena (Resend: https://resend.com)
# El dominio del remitente debe estar verificado en Resend (SPF y DKIM).
RESEND_API_KEY=
FROM_EMAIL=Rescate <rescate@tudominio.com>
# Notificaciones push en hostings donde no puedes subir el archivo JSON:
# pega aqui el contenido de firebase-service-account.json (o su version base64)
# FIREBASE_CREDENTIALS_JSON=

# Carpeta de las fotos de los packs. En produccion debe ser un volumen
# persistente (en Docker ya queda en /data/uploads)
# UPLOADS_DIR=

# Solo si algun dia hay un sitio web que llame a la API, sus dominios separados
# por comas. La app movil NO lo necesita.
# CORS_ORIGINS=https://tuweb.com

# Solo en desarrollo: 1 = muestra el codigo en la consola si no hay llave de Resend
# DEV_PRINT_EMAILS=1

# Reservas que no se retiran (opcional, estos son los valores por defecto)
# NO_SHOW_GRACE_MINUTES=30   minutos de gracia tras terminar el horario de retiro
# NO_SHOW_LIMIT=3            no retiros que bloquean nuevas reservas (0 = no bloquear)
# NO_SHOW_WINDOW_DAYS=30     dias que cuenta cada no retiro
